{{ 'bwlt.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} .bw-pad{padding-top:{{ section.settings.padding_top | times: 0.75 | round: 0 }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px}
  @media screen and (min-width:750px){#shopify-section-{{ section.id }} .bw-pad{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
<div class="page-width bw-pad" id="lifting">
  {%- if section.settings.eyebrow != blank -%}<p class="bw-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <div class="bw-lifting">
    {%- for block in section.blocks -%}
      <a class="bw-cap{% if block.settings.highlight %} bw-cap--hi{% endif %}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        <span class="bw-cap__t">{{ block.settings.title }}</span>
        <span class="bw-cap__v">{{ block.settings.vehicles }}</span>
        <span class="bw-cap__r">{{ block.settings.result | replace: '<p>', '' | replace: '</p>', '' }}</span>
        <span class="bw-cap__c">{{ block.settings.ceiling }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>
</div>
{% schema %}
{
  "name": "BW: lifting cards",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Start here — what are you lifting?"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},
    {"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Top padding","default":44},
    {"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Bottom padding","default":44}
  ],
  "blocks": [{"type":"card","name":"Card","settings":[
    {"type":"text","id":"title","label":"Title","default":"Half-ton & EV trucks"},
    {"type":"text","id":"vehicles","label":"Example vehicles","default":"F-150, Silverado, Rivian R1T, Cybertruck"},
    {"type":"richtext","id":"result","label":"Result line","default":"<p>→ 10K lift, from <strong>$3,600</strong></p>"},
    {"type":"text","id":"ceiling","label":"Ceiling note","default":"needs 12′ ceiling, or 10′6″ with a floor-plate model"},
    {"type":"url","id":"link","label":"Link"},
    {"type":"checkbox","id":"highlight","label":"Highlight (dark border)","default":false}
  ]}],
  "presets": [{"name":"BW: lifting cards","blocks":[
    {"type":"card","settings":{"title":"Cars & crossovers","vehicles":"Model Y, Camry, Wrangler — under 6,000 lb","result":"<p>→ OH-9, <strong>$2,745</strong></p>","ceiling":"needs [SPEC] ceiling","link":"shopify://products/amgo-oh-9-9000-lbs-2-post-lift"}},
    {"type":"card","settings":{"title":"Half-ton & EV trucks","vehicles":"F-150, Silverado, Rivian R1T, Cybertruck","result":"<p>→ OHX-10, <strong>$3,600</strong></p>","ceiling":"needs 12′ ceiling","highlight":true}},
    {"type":"card","settings":{"title":"3/4- and one-ton","vehicles":"F-250/350, Ram 2500, Sprinter, Transit","result":"<p>→ OH-12S, <strong>$4,395</strong></p>","ceiling":"needs 12′6″ ceiling","link":"shopify://products/amgo-oh-12s-12000-lbs-2-post-lift"}},
    {"type":"card","settings":{"title":"Storage, not service","vehicles":"Park one car over another; 7–9K four-post","result":"<p>→ 407-P / 408-P / 409-HP, from <strong>$2,980</strong></p>","ceiling":"needs [SPEC] ceiling"}}
  ]}]
}
{% endschema %}
