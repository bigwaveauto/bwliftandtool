{{ 'bwlt.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} .bw-pad{padding-top:{{ section.settings.padding_top | times: 0.75 | round: 0 }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px}
  @media screen and (min-width:750px){#shopify-section-{{ section.id }} .bw-pad{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
<div class="page-width bw-pad">
  <div class="bw-duo">
    {%- for block in section.blocks -%}
      <div class="bw-duo__item" {{ block.shopify_attributes }}>
        <div class="bw-img" style="aspect-ratio:1/1">
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}
        </div>
        <div>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.link_label != blank -%}<a class="link" href="{{ block.settings.link }}">{{ block.settings.link_label }} →</a>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
</div>
{% schema %}
{
  "name": "BW: two panels",
  "settings": [
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-2"},
    {"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Top padding","default":36},
    {"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Bottom padding","default":36}
  ],
  "blocks": [{"type":"panel","name":"Panel","limit":2,"settings":[
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"heading","label":"Heading","default":"Tire changers & balancers"},
    {"type":"textarea","id":"text","label":"Text","default":"Coats, made in Tennessee, and AMGO. Coats is quote-only; we turn quotes around the same day."},
    {"type":"text","id":"link_label","label":"Link label","default":"Tire & wheel"},
    {"type":"url","id":"link","label":"Link"}
  ]}],
  "presets": [{"name":"BW: two panels","blocks":[
    {"type":"panel","settings":{"heading":"Tire changers & balancers","text":"Coats, made in Tennessee, and AMGO. Coats is quote-only; we turn quotes around the same day.","link_label":"Tire & wheel","link":"shopify://collections/tire-and-wheel"}},
    {"type":"panel","settings":{"heading":"Rotary, Atlas, BendPak, Challenger","text":"We sell them; we just don't print a price, because theirs moves. Send the model number and a ZIP and you'll have a landed price today.","link_label":"Request a quote","link":"shopify://pages/request-a-quote"}}
  ]}]
}
{% endschema %}
