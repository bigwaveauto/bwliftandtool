{{ 'bwlt.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} .bw-pad{padding-top:{{ section.settings.padding_top | times: 0.75 | round: 0 }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px}
  @media screen and (min-width:750px){#shopify-section-{{ section.id }} .bw-pad{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
<div class="page-width bw-pad">
  <div class="bw-who">
    <div class="bw-img" style="aspect-ratio:16/10">
      {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
    </div>
    <div>
      <h2 class="h2" style="margin:0 0 1.2rem">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.address != blank -%}<div class="bw-who__addr">{{ section.settings.address }}</div>{%- endif -%}
      <div class="bw-btns">
        {%- if section.settings.button_label_1 != blank -%}<a class="button" href="{{ section.settings.button_link_1 }}">{{ section.settings.button_label_1 }}</a>{%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}<a class="button button--secondary" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</div>
</div>
{% schema %}
{
  "name": "BW: who we are",
  "settings": [
    {"type":"image_picker","id":"image","label":"Photo"},
    {"type":"text","id":"heading","label":"Heading","default":"Who you're buying from"},
    {"type":"richtext","id":"text","label":"Text","default":"<p>I'm Dave Lucas. I own Big Wave Auto, an independent dealership in Sussex, and we recondition our own inventory on a lift in our bay. BW Lift &amp; Tool is me selling the equipment I'd buy again, through a distributor I've dealt with for years, at a price that's on the page. Come see one run before you buy — by appointment, Mon–Sat 9–6.</p>"},
    {"type":"text","id":"address","label":"Address line","default":"N69W25055 Indiangrass Ln Unit H, Sussex, WI 53089 · [PHONE]"},
    {"type":"text","id":"button_label_1","label":"Button 1","default":"Call or text"},
    {"type":"url","id":"button_link_1","label":"Button 1 link"},
    {"type":"text","id":"button_label_2","label":"Button 2","default":"Request a quote"},
    {"type":"url","id":"button_link_2","label":"Button 2 link"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-4"},
    {"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Top padding","default":44},
    {"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Bottom padding","default":44}
  ],
  "presets": [{"name":"BW: who we are"}]
}
{% endschema %}
